}

model Gender {
  genderId  String   @id(map: "pk_genders") @default(uuid()) @map("gender_id") @db.Uuid
  name      String   @unique(map: "uq_genders_name") @db.VarChar(50)
  isActive  Boolean? @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  persons   Person[]

  @@index([isActive], map: "idx_genders_is_active")
  @@map("genders")
}

model GlobalNotificationRead {
  globalNotificationId String             @map("global_notification_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  readAt               DateTime?          @map("read_at") @db.Timestamptz(6)
  originSessionId      String?            @map("origin_session_id") @db.Uuid
  originCorrelationId  String?            @map("origin_correlation_id") @db.VarChar(128)
  globalNotification   GlobalNotification @relation(fields: [globalNotificationId], references: [globalNotificationId], onDelete: Cascade, map: "fk_global_notification_reads_global_notification_id")
  user                 User               @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "fk_global_notification_reads_user_id")

  @@id([globalNotificationId, userId], map: "pk_global_notification_reads")
  @@index([globalNotificationId], map: "idx_global_notification_reads_global_notification_id")
  @@index([readAt], map: "idx_global_notification_reads_read_at")
  @@index([userId], map: "idx_global_notification_reads_user_id")
  @@index([originSessionId], map: "idx_global_notification_reads_origin_session_id")
  @@map("global_notification_reads")
}

/// Notificación para todos los clientes: una fila in-app que todos ven + envío masivo por push/email.
/// El envío va por páginas de usuarios (orden user_id) y guarda su avance en cursor_user_id: si el proceso
/// muere, la reserva (locked_until) vence y el despachador lo retoma desde el cursor.
model GlobalNotification {
  globalNotificationId    String                   @id(map: "pk_global_notifications") @default(uuid()) @map("global_notification_id") @db.Uuid
  notificationTypeId      String?                  @map("notification_type_id") @db.Uuid
  title                   String
  body                    String
  metadata                Json?
  sendPush                Boolean                  @default(false) @map("send_push")
  sendEmail               Boolean                  @default(false) @map("send_email")
  /// Envío masivo: pending → processing → completed (failed: no se puede enviar, p. ej. sin tipo).
  status                  GlobalNotificationStatus @default(pending)
  /// Último user_id ya enviado; la próxima página empieza después de él.
  cursorUserId            String?                  @map("cursor_user_id") @db.Uuid
  /// Reserva del envío en curso; vencida, el despachador lo retoma.
  lockedUntil             DateTime?                @map("locked_until") @db.Timestamptz(6)
  pushSentCount           Int                      @default(0) @map("push_sent_count")
  emailSentCount          Int                      @default(0) @map("email_sent_count")
  originSessionId         String?                  @map("origin_session_id") @db.Uuid
  originCorrelationId     String?                  @map("origin_correlation_id") @db.VarChar(128)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  globalNotificationReads GlobalNotificationRead[]
  notificationType        NotificationType?        @relation(fields: [notificationTypeId], references: [notificationTypeId], map: "fk_global_notifications_notification_type_id")

  @@index([status], map: "idx_global_notifications_status")
  @@index([notificationTypeId], map: "idx_global_notifications_notification_type_id")
  @@index([originSessionId], map: "idx_global_notifications_origin_session_id")
  @@map("global_notifications")
}

model NotificationCategory {
  notificationCategoryId String             @id(map: "pk_notification_categories") @default(uuid()) @map("notification_category_id") @db.Uuid
  code                   String             @unique(map: "uq_notification_categories_code") @db.VarChar(100)
  name                   String             @db.VarChar(200)
  description            String?
  supportsPush           Boolean            @default(true) @map("supports_push")
  supportsEmail          Boolean            @default(true) @map("supports_email")
  supportsSms            Boolean            @default(false) @map("supports_sms")
  /// Crítica: se envía siempre, sin mirar las preferencias ni el horario de silencio del usuario.
  isCritical             Boolean            @default(false) @map("is_critical")
  emailLayoutTemplate    String?            @map("email_layout_template")
  isActive               Boolean            @default(true) @map("is_active")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  notificationTypes      NotificationType[]

  @@index([isActive], map: "idx_notification_categories_is_active")
  @@map("notification_categories")
}

model NotificationType {
  notificationTypeId     String                @id(map: "pk_notification_types") @default(uuid()) @map("notification_type_id") @db.Uuid
  code                   String                @unique(map: "uq_notification_types_code") @db.VarChar(100)
  name                   String                @db.VarChar(200)
  description            String?
  titleTemplate          String                @map("title_template")
  bodyTemplate           String                @map("body_template")
  emailSubjectTemplate   String?               @map("email_subject_template")
  emailBodyTemplate      String?               @map("email_body_template")
  isActive               Boolean?              @default(true) @map("is_active")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  notificationCategoryId String?               @map("notification_category_id") @db.Uuid
  globalNotifications    GlobalNotification[]
  category               NotificationCategory? @relation(fields: [notificationCategoryId], references: [notificationCategoryId], map: "fk_notification_types_notification_category_id")
  notifications          Notification[]

  @@index([notificationCategoryId], map: "idx_notification_types_category_id")
  @@index([isActive], map: "idx_notification_types_is_active")
  @@map("notification_types")
}

/// Bandeja in-app del usuario. El envío por canales externos vive en notification_deliveries.
model Notification {
  notificationId     String                 @id(map: "pk_notifications") @default(uuid()) @map("notification_id") @db.Uuid
  userId             String                 @map("user_id") @db.Uuid
  notificationTypeId String?                @map("notification_type_id") @db.Uuid
  title              String
  body               String
  relatedEntityType  String?                @map("related_entity_type") @db.VarChar(50)
  relatedEntityId    String?                @map("related_entity_id") @db.Uuid
  metadata           Json?
  isRead             Boolean?               @default(false) @map("is_read")
  readAt             DateTime?              @map("read_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveries         NotificationDelivery[]
  notificationType   NotificationType?      @relation(fields: [notificationTypeId], references: [notificationTypeId], map: "fk_notifications_notification_type_id")
  user               User                   @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "fk_notifications_user_id")

  @@index([notificationTypeId], map: "idx_notifications_notification_type_id")
  @@index([relatedEntityType, relatedEntityId], map: "idx_notifications_related_entity_type_related_entity_id")
  @@index([userId], map: "idx_notifications_user_id")
  @@index([userId, createdAt], map: "idx_notifications_user_id_created_at")
  @@index([userId, isRead, createdAt], map: "idx_notifications_user_id_is_read_created_at")
  @@map("notifications")
}

/// Envío de una notificación por un canal externo (una fila por canal que aplica). El despachador toma
/// las pendientes con next_attempt_at vencido (docs/notifications.md).
model NotificationDelivery {
  notificationDeliveryId String                     @id(map: "pk_notification_deliveries") @default(uuid()) @map("notification_delivery_id") @db.Uuid
  notificationId         String                     @map("notification_id") @db.Uuid
  channel                NotificationChannel
  status                 NotificationDeliveryStatus @default(pending)
  attempts               Int                        @default(0)
  /// Próximo intento (pendiente) o fin de la reserva del intento en curso; null cuando ya terminó.
  nextAttemptAt          DateTime?                  @map("next_attempt_at") @db.Timestamptz(6)
  sentAt                 DateTime?                  @map("sent_at") @db.Timestamptz(6)
  lastError              String?                    @map("last_error")
  /// Código del proveedor del último fallo (p. ej. MessageRejected): decide si es un rebote definitivo.
  lastErrorCode          String?                    @map("last_error_code") @db.VarChar(100)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  notification           Notification               @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade, map: "fk_notification_deliveries_notification_id")

  @@unique([notificationId, channel], map: "uq_notification_deliveries_notification_id_channel")
  @@index([status, nextAttemptAt], map: "idx_notification_deliveries_status_next_attempt_at")
  @@map("notification_deliveries")
}

/// Una fila por operación (petición HTTP, webhook, ciclo de worker o tarea de sistema): se inserta al
/// empezar (running) y se actualiza al terminar. operation_id = correlationId de logs, auditoría y llamadas
/// externas. Ver docs/ARCHITECTURE.md (Auditoría, operaciones y logs).
model Operation {
  operationId     String          @id(map: "pk_operations") @map("operation_id") @db.VarChar(100)
  parentId        String?         @map("parent_id") @db.VarChar(100)
  clientRequestId String?         @map("client_request_id") @db.VarChar(128)
  source          OperationSource
  name            String          @db.VarChar(255)
  userId          String?         @map("user_id") @db.Uuid
  sessionId       String?         @map("session_id") @db.Uuid
  ip              String?         @db.VarChar(45)
  status          OperationStatus @default(running)
  httpStatus      Int?            @map("http_status") @db.SmallInt
  errorCode       String?         @map("error_code") @db.VarChar(100)
  errorMessage    String?         @map("error_message")
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?       @map("ended_at") @db.Timestamptz(6)
  durationMs      Int?            @map("duration_ms")

  @@index([startedAt], map: "idx_operations_started_at")
  @@index([status, startedAt], map: "idx_operations_status_started_at")
  @@index([userId, startedAt], map: "idx_operations_user_started_at")
  @@index([source, startedAt], map: "idx_operations_source_started_at")
  @@index([parentId], map: "idx_operations_parent_id")
  @@map("operations")
}

/// Claves de idempotencia: la primera petición con una clave se ejecuta y guarda su respuesta; las que
/// repiten la clave (reintentos tras un timeout) reciben esa respuesta sin ejecutar de nuevo. Una fila por
/// (scope, clave): scope = quién llama (usuario o sistema externo), así dos clientes no comparten claves.
/// Ver docs/idempotency.md.
model IdempotencyKey {
  scope          String               @db.VarChar(100)
  key            String               @map("idempotency_key") @db.VarChar(255)
  /// SHA-256 de método + ruta + body: la misma clave con otra petición es un error del cliente (422).
  requestHash    String               @map("request_hash") @db.Char(64)
  status         IdempotencyKeyStatus @default(in_progress)
  responseStatus Int?                 @map("response_status") @db.SmallInt
  responseBody   Json?                @map("response_body")
  /// Mientras está en curso: hasta cuándo la petición dueña tiene la clave. Si vence (el proceso se cayó a
  /// mitad), otra petición con la misma clave la retoma.
  lockedUntil    DateTime?            @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(6)

  @@id([scope, key], map: "pk_idempotency_keys")
  @@index([expiresAt], map: "idx_idempotency_keys_expires_at")
  @@map("idempotency_keys")
}

