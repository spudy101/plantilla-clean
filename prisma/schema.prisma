  emailHash                String                       @unique(map: "uq_email_bounce_suppressions_email_hash") @map("email_hash") @db.VarChar(64)
  userId                   String?                      @map("user_id") @db.Uuid
  bounceCount              Int                          @default(0) @map("bounce_count")
  status                   EmailBounceSuppressionStatus @default(active)
