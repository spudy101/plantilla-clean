generator client {
  provider        = "prisma-client"
  output          = "../src/shared/database/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ApprovalRequest {
  approvalRequestId   String                @id(map: "pk_approval_requests") @default(dbgenerated("gen_random_uuid()")) @map("approval_request_id") @db.Uuid
  operationKey        String                @map("operation_key") @db.VarChar(100)
  entityType          String?               @map("entity_type") @db.VarChar(100)
  entityId            String?               @map("entity_id") @db.Uuid
  payload             Json                  @default("{}")
  requestedBy         String                @map("requested_by") @db.Uuid
  requestedAt         DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  status              ApprovalRequestStatus @default(pending)
  secondApproverId    String?               @map("second_approver_id") @db.Uuid
  resolvedAt          DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes     String?               @map("resolution_notes")
  expiresAt           DateTime?             @map("expires_at") @db.Timestamptz(6)
  result              Json?
  originSessionId     String?               @map("origin_session_id") @db.Uuid
  originCorrelationId String?               @map("origin_correlation_id") @db.VarChar(128)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requester           User                  @relation("ApprovalRequest_requester", fields: [requestedBy], references: [userId], map: "fk_approval_requests_requested_by")
  secondApprover      User?                 @relation("ApprovalRequest_secondApprover", fields: [secondApproverId], references: [userId], map: "fk_approval_requests_second_approver_id")

  @@unique([entityType, entityId, operationKey], map: "uq_approval_requests_pending_entity_op", where: raw("(status = 'pending'::enum_approval_requests_status)"))
  @@index([entityType, entityId], map: "idx_approval_requests_entity")
  @@index([expiresAt], map: "idx_approval_requests_expires_at")
  @@index([operationKey], map: "idx_approval_requests_operation_key")
  @@index([originSessionId], map: "idx_approval_requests_origin_session_id")
  @@index([requestedBy], map: "idx_approval_requests_requested_by")
  @@index([status], map: "idx_approval_requests_status")
  @@map("approval_requests")
}

model AuditAlert {
  auditAlertId   String         @id(map: "pk_audit_alerts") @default(uuid()) @map("audit_alert_id") @db.Uuid
  auditLogId     String?        @map("audit_log_id") @db.Uuid
  action         String         @db.VarChar(100)
  category       String?        @db.VarChar(50)
  risk           AuditAlertRisk @default(high)
  userId         String?        @map("user_id") @db.Uuid
  entityId       String?        @map("entity_id") @db.VarChar(255)
  entityType     String?        @map("entity_type") @db.VarChar(100)
  message        String?
  acknowledged   Boolean        @default(false)
  acknowledgedBy String?        @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?      @map("acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action], map: "idx_audit_alerts_action")
  @@index([createdAt], map: "idx_audit_alerts_created_at")
  @@index([userId], map: "idx_audit_alerts_user_id")
  @@index([acknowledged, createdAt], map: "idx_audit_alerts_pending")
  @@map("audit_alerts")
}

model AuditLog {
  auditLogId    String          @id(map: "pk_audit_logs") @default(uuid()) @map("audit_log_id") @db.Uuid
  action        String          @db.VarChar(100)
  description   String?         @db.VarChar(255)
  category      String?         @db.VarChar(50)
  risk          AuditLogRisk    @default(unknown)
  outcome       AuditLogOutcome @default(success)
  userId        String?         @map("user_id") @db.Uuid
  correlationId String?         @map("correlation_id") @db.VarChar(100)
  ip            String?         @db.VarChar(45)
  userAgent     String?         @map("user_agent")
  fingerprint   String?         @db.VarChar(64)
  details       Json?
  source        String          @default("http") @db.VarChar(50)
  entityId      String?         @map("entity_id") @db.VarChar(255)
  entityType    String?         @map("entity_type") @db.VarChar(100)
  entityTable   String?         @map("entity_table") @db.VarChar(150)
  module        String?         @db.VarChar(50)
  sessionId     String?         @map("session_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([action], map: "idx_audit_logs_action")
  @@index([correlationId], map: "idx_audit_logs_correlation_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([category, risk, createdAt], map: "idx_audit_logs_category_risk_date")
  @@index([entityId], map: "idx_audit_logs_entity_id")
  @@index([outcome, createdAt], map: "idx_audit_logs_outcome_date")
  @@index([sessionId, createdAt], map: "idx_audit_logs_session_date")
  @@index([userId, createdAt], map: "idx_audit_logs_user_date")
  @@map("audit_logs")
}

model AvatarTheme {
  avatarThemeId String   @id(map: "pk_avatar_themes") @default(uuid()) @map("avatar_theme_id") @db.Uuid
  name          String   @unique(map: "uq_avatar_themes_name") @db.VarChar(100)
  isActive      Boolean? @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  avatars       Avatar[]

  @@index([isActive], map: "idx_avatar_themes_is_active")
  @@map("avatar_themes")
}

model Avatar {
  avatarId      String      @id(map: "pk_avatars") @default(uuid()) @map("avatar_id") @db.Uuid
  name          String      @db.VarChar(100)
  avatarThemeId String      @map("avatar_theme_id") @db.Uuid
  imageUrl      String?     @map("image_url") @db.VarChar(255)
  isActive      Boolean?    @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  theme         AvatarTheme @relation(fields: [avatarThemeId], references: [avatarThemeId], map: "fk_avatars_avatar_theme_id")
  users         User[]

  @@index([avatarThemeId], map: "idx_avatars_avatar_theme_id")
  @@index([isActive], map: "idx_avatars_is_active")
  @@map("avatars")
}

model BiometricChallenge {
  biometricChallengeId String   @id(map: "pk_biometric_challenges") @default(uuid()) @map("biometric_challenge_id") @db.Uuid
  userId               String?  @map("user_id") @db.Uuid
  challenge            String   @unique(map: "uq_biometric_challenges_challenge")
  type                 String   @db.VarChar(20)
  used                 Boolean  @default(false)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user                 User?    @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "fk_biometric_challenges_user_id")

  @@index([expiresAt], map: "idx_biometric_challenges_expires_at")
  @@index([userId], map: "idx_biometric_challenges_user_id")
  @@map("biometric_challenges")
}

model City {
  cityId          String           @id(map: "pk_cities") @default(uuid()) @map("city_id") @db.Uuid
  name            String           @db.VarChar(100)
  daneCode        String?          @map("dane_code") @db.VarChar(3)
  departmentId    String           @map("department_id") @db.Uuid
  isActive        Boolean?         @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  department      Department       @relation(fields: [departmentId], references: [departmentId], map: "fk_cities_department_id")
  personLocations PersonLocation[]

  @@index([departmentId], map: "idx_cities_department_id")
  @@index([departmentId, name], map: "idx_cities_department_id_name")
  @@index([isActive], map: "idx_cities_is_active")
  @@index([name], map: "idx_cities_name")
  @@map("cities")
}

/// CHECK consent_types_scope_check (scope IN ('ONBOARDING')): Prisma no modela los CHECK; vive en SQL crudo en prisma/migrations/0_init.
model ConsentType {
  consentTypeId String        @id(map: "pk_consent_types") @default(uuid()) @map("consent_type_id") @db.Uuid
  code          String        @unique(map: "uq_consent_types_code") @db.VarChar(50)
  name          String        @db.VarChar(200)
  description   String?
  isMandatory   Boolean       @default(true) @map("is_mandatory")
  isRevocable   Boolean       @default(false) @map("is_revocable")
  isActive      Boolean       @default(true) @map("is_active")
  scope         String        @default("ONBOARDING") @db.VarChar(20)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  userConsents  UserConsent[]

  @@index([isActive], map: "idx_consent_types_is_active")
  @@map("consent_types")
}

model Country {
  countryId       String           @id(map: "pk_countries") @default(uuid()) @map("country_id") @db.Uuid
  name            String           @unique(map: "uq_countries_name") @db.VarChar(100)
  code            String           @unique(map: "uq_countries_code") @db.VarChar(3)
  iconUrl         String?          @map("icon_url") @db.VarChar(255)
  isActive        Boolean?         @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  departments     Department[]
  personLocations PersonLocation[]
  persons         Person[]
  phonePrefixes   PhonePrefix[]

  @@index([isActive], map: "idx_countries_is_active")
  @@map("countries")
}

model Department {
  departmentId    String           @id(map: "pk_departments") @default(uuid()) @map("department_id") @db.Uuid
  name            String           @db.VarChar(100)
  daneCode        String?          @map("dane_code") @db.VarChar(2)
  countryId       String           @map("country_id") @db.Uuid
  isActive        Boolean?         @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  cities          City[]
  country         Country          @relation(fields: [countryId], references: [countryId], map: "fk_departments_country_id")
  personLocations PersonLocation[]

  @@index([countryId], map: "idx_departments_country_id")
  @@index([countryId, name], map: "idx_departments_country_id_name")
  @@index([isActive], map: "idx_departments_is_active")
  @@index([name], map: "idx_departments_name")
  @@map("departments")
}

model DocumentType {
  documentTypeId    String   @id(map: "pk_document_types") @default(uuid()) @map("document_type_id") @db.Uuid
  code              String   @unique(map: "uq_document_types_code") @db.VarChar(20)
  name              String   @db.VarChar(100)
  isVisibleToClient Boolean  @default(true) @map("is_visible_to_client")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  persons           Person[]

  @@index([isActive], map: "idx_document_types_is_active")
  @@index([isVisibleToClient], map: "idx_document_types_is_visible_to_client")
  @@map("document_types")
}

model EmailBounceSuppression {
