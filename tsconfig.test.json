{
  // Typecheck de todo lo que no entra al build: tests (Jest solo transpila), el seed (prisma/) y los
  // scripts (corren con tsx desde las fuentes).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "tests/*": ["tests/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "prisma/**/*.ts", "prisma.config.ts", "scripts/*.ts", "scripts/lib/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
