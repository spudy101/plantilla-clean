# ==============================================
# SERVER
# ==============================================
NODE_ENV=development
# PORT lo usan los tres modos (monolito, admin o client). Solo corre uno a la vez:
# el "modo" se elige por el comando que levantas (npm start / start:admin / start:client),
# no por puertos distintos.
PORT=4000
HOST=localhost

# ==============================================
# CORS
# ==============================================
CORS_ORIGIN=*
# En produccion: CORS_ORIGIN=https://tuapp.com,https://admin.tuapp.com

# ==============================================
# DATABASE - PostgreSQL [REQUERIDO]
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public
# Esquema aislado de los tests de integración (npm run db:test:prepare). Nunca `public`.
# TEST_DB_SCHEMA=test
DB_LOGGING=false

# ==============================================
# REDIS CACHE [OPCIONAL]
# Si no se configura, usa cache en memoria local
# ==============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_URL=

# ==============================================
# ENCRYPTION [REQUERIDO — sin estas claves el cifrado de datos sensibles no funciona]
# Generar con: node scripts/generate-keys.util.js
# AES_KEY: 64 chars hex (32 bytes) — para AES-256-GCM
# AES_IV:  32 chars hex (16 bytes) — solo para descifrar datos legados AES-CBC (GCM usa IV aleatorio por operación)
# Generar claves: node scripts/generate-keys.util.js
# ==============================================
AES_KEY=
AES_IV=
ENCRYPTION_ALGORITHM=aes-256-gcm
# HMAC_SECRET: eliminado — el anti-replay usa secrets por dispositivo
# guardados en la tabla user_trusted_devices (cifrados con AES).
# No se configura en .env ni en Terraform.
EXTERNAL_API_KEYS=
HASH_PEPPER=

# ==============================================
# AWS [REQUERIDO]
# ==============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=

# ==============================================
# FRONTEND URLs [REQUERIDO]
# ==============================================
FRONTEND_RESET_URL=http://localhost:3000/reset-credentials

# ==============================================
# NOTIFICATIONS [OPCIONAL]
# El sistema funciona sin estas, solo no notificara
# ==============================================
SNS_PLATFORM_ARN_IOS=
SNS_PLATFORM_ARN_ANDROID=
# Topic SNS al que SES publica los bounces de correo (webhook de supresión). Opcional.
SNS_BOUNCE_TOPIC_ARN=
SES_FROM_EMAIL=
# Tope por minuto de los envíos masivos (globales). Ajustar a la cuota de la cuenta de AWS.
SNS_RATE_LIMIT_PER_MINUTE=300
SES_RATE_LIMIT_PER_MINUTE=200
# URLs generadas por CloudFront — en producción vienen del output de Terraform
# En local usa placeholders o deja vacío
LOGO_URL=http://localhost:3000/brand/logo.png
PRIVACY_POLICY_URL=http://localhost:3000/legal/privacy-policy-v1.0.pdf
S3_PUBLIC_BUCKET_NAME=
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_BASE_URL=
ADMIN_EMAIL=

# ==============================================
# MOCK DE PROVEEDORES EXTERNOS
# ==============================================
# Mientras no exista una integración real de SMS/biométrico, este flag simula
# el envío de SMS (OTP fijo 123456) y la aprobación biométrica para desbloquear
# el onboarding y el MFA en desarrollo.
# Default si se omite: activo fuera de producción, apagado en producción.
# Apagar (false) en producción y al implementar las integraciones reales.
MOCK_EXTERNAL_PROVIDERS=true

# ==============================================
# CAPTCHA
# ==============================================
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=

# ==============================================
# JWT — claves RS256 [REQUERIDO]
# ==============================================
# Firman y verifican los tokens propios de autorización (access + refresh) y el
# reto MFA. Sin ellas el arranque falla (validateJwt).
# Formato PEM con los saltos de línea escritos como \n literal (config.js los
# reemplaza al leer). Genera el par con:
#   node scripts/generate-keys.util.js      (imprime JWT_PRIVATE_KEY / JWT_PUBLIC_KEY listos para pegar)
# o con openssl:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Opcionales (tienen default: access 900s = 15min, refresh 604800s = 7d)
# JWT_ACCESS_TOKEN_EXPIRY=900
# JWT_REFRESH_TOKEN_EXPIRY=604800

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info
# debug | info | warn | error
# Días que se conserva la traza de operaciones (tabla operations). Default 90.
OPERATIONS_RETENTION_DAYS=90

# ==============================================
# WORKERS
# ==============================================
ENABLE_WORKERS=true

# ==============================================
# SEEDS — usuario admin inicial
# ==============================================
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_NATIONAL_ID=
SEED_ADMIN_PASSWORD=

LOCALHOST= true

